# Copy to .env.local and adjust.

# Where the LegitCheck API (FastAPI) runs. No trailing slash.
# Local: http://localhost:8000  Deployed: e.g. https://legitcheck-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Only for GitHub Pages project sites, where the app lives under /<repo-name>.
# Leave empty for Vercel or a custom domain. Example: /legitcheck
NEXT_PUBLIC_BASE_PATH=
