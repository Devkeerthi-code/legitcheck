# ---- API (FastAPI) ----

# Optional. Google Gemini key, used ONLY to rewrite the explanation in plain language
# or translate it (hi/ta/kn/te). Leave empty and the app uses built-in templates.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Gemini model name. Default: gemini-3.5-flash-lite (fast, ~1s)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Postgres URL for usage counts (e.g. Neon free tier).
# Leave empty to use a local SQLite file (legitcheck_usage.db).
# Example: postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Comma-separated origins allowed to call the API (your web app URLs).
# The Chrome extension is allowed separately via EXTENSION_ID below.
ALLOWED_ORIGINS=http://localhost:3000

# Optional. Your unpacked/published extension ID (chrome://extensions) to allow its CORS origin.
# Leave empty to allow any chrome-extension:// origin (fine for local development).
EXTENSION_ID=

# Requests allowed per IP. slowapi syntax.
RATE_LIMIT=20/minute;200/day

# ---- Web (Next.js) — put these in web/.env.local ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
