{
  "name": "legitcheck",
  "private": true,
  "description": "Runs the LegitCheck API and web app together for local development.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "python -m uvicorn legitcheck.api.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:web": "npm --prefix web run dev"
  },
  "devDependencies": {
    "concurrently": "9.2.1"
  }
}
